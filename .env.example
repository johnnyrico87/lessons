# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# All keys are OPTIONAL — the app runs fully local with none of them.

# Optional cloud LLM for extraction (opt-in; default is local Ollama).
# Leave blank to use Ollama. Set a key to use a cloud model instead.
LESSONS_CLOUD_LLM_API_KEY=

# Optional: override the default local Ollama model (Phase 3).
# LESSONS_OLLAMA_MODEL=

# Optional: override the port the local web app binds on 127.0.0.1 (Phase 5).
# LESSONS_PORT=8787
